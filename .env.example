# HireTrends Environment Configuration
# Copy this file to .env and adjust variables as needed for local development.
# NEVER commit the real .env file with private credentials to version control.

# Crawler Identity Configuration
CRAWLER_USER_AGENT=HireTrendsResearchBot/1.0 (+https://github.com/Awaisbacha55/hiretrends-pakistan-job-market; academic research)
CRAWLER_CONTACT_EMAIL=researcher@hiretrends.local

# Scraping Engine Settings
REQUEST_TIMEOUT=15
DEFAULT_REQUEST_DELAY=3.0
MAX_RETRIES=3
MAX_CONCURRENT_REQUESTS=1

# Storage Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLES_DIR=data/samples

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Headcount Labs API
HEADCOUNTLABS_API_KEY=